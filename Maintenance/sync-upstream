#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

fail() {
  printf 'sync-upstream: %s\n' "$1" >&2
  exit 1
}

command -v git >/dev/null || fail "git is required"
command -v rg >/dev/null || fail "rg is required"
command -v tar >/dev/null || fail "tar is required"
command -v perl >/dev/null || fail "perl is required"

LOCK_TAG="$(sed -n 's/^swift-format.tag = \"\([^\"]*\)\"$/\1/p' Upstream.lock)"
LOCK_FORMAT_SHA="$(sed -n 's/^swift-format.sha = \"\([^\"]*\)\"$/\1/p' Upstream.lock)"
LOCK_SYNTAX_TAG="$(sed -n 's/^swift-syntax.tag = \"\([^\"]*\)\"$/\1/p' Upstream.lock)"
LOCK_SYNTAX_SHA="$(sed -n 's/^swift-syntax.sha = \"\([^\"]*\)\"$/\1/p' Upstream.lock)"
LOCK_SWIFT_VERSION="$(sed -n 's/^swift.toolchain = \"Swift \([^\"]*\)\"$/\1/p' Upstream.lock)"

[[ -n "$LOCK_TAG" ]] || fail "Upstream.lock must pin a swift-format tag"
[[ -n "$LOCK_SYNTAX_TAG" ]] || fail "Upstream.lock must pin a swift-syntax tag"
[[ -n "$LOCK_SWIFT_VERSION" ]] || fail "Upstream.lock must pin a Swift toolchain version"
[[ "$LOCK_FORMAT_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "invalid swift-format full SHA"
[[ "$LOCK_SYNTAX_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "invalid swift-syntax full SHA"

CURRENT_SWIFT_VERSION="$(
  swift --version | sed -n 's/.*Swift version \([0-9][0-9.]*\).*/\1/p' | head -n 1
)"
[[ "$CURRENT_SWIFT_VERSION" == "$LOCK_SWIFT_VERSION" ]] \
  || fail "active Swift $CURRENT_SWIFT_VERSION does not match locked Swift $LOCK_SWIFT_VERSION"

TAG_SHA="$(git rev-parse --verify "refs/tags/$LOCK_TAG^{commit}")"
[[ "$TAG_SHA" == "$LOCK_FORMAT_SHA" ]] \
  || fail "local tag $LOCK_TAG does not resolve to the Upstream.lock SHA"
rg -q "revision: \"$LOCK_SYNTAX_SHA\"" Package.swift \
  || fail "Package.swift does not use the locked swift-syntax revision"

verify_syntax_sha() {
  local checkout="${SWIFTSYNTAX_CHECKOUT:-.build/checkouts/swift-syntax}"
  [[ -d "$checkout/.git" ]] \
    || fail "swift-syntax checkout is required locally; set SWIFTSYNTAX_CHECKOUT"
  local actual
  actual="$(
    git -C "$checkout" rev-parse --verify "refs/tags/$LOCK_SYNTAX_TAG^{commit}" 2>/dev/null \
      || true
  )"
  [[ "$actual" == "$LOCK_SYNTAX_SHA" ]] \
    || fail "local swift-syntax tag does not resolve to the locked revision"
}

verify_syntax_sha

read_files_manifest() {
  files=()
  unchanged_files=()
  transformed_files=()
  local section=""
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "# A:"*) section="A"; continue ;;
      "# C:"*) section="C"; continue ;;
      ""|\#*) continue ;;
    esac
    [[ -n "$section" ]] || fail "files.txt path appears before an ownership section: $line"
    files+=("$line")
    if [[ "$section" == "A" ]]; then
      unchanged_files+=("$line")
    else
      transformed_files+=("$line")
    fi
  done < Maintenance/files.txt
}

read_rules_manifest() {
  rules=()
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    rules+=("$line")
  done < Maintenance/rules.txt
}

read_test_sources_lock() {
  test_destinations=()
  test_sources=()
  test_source_blobs=()
  support_destinations=()
  support_sources=()
  support_source_blobs=()
  local line
  local kind
  local destination
  local source
  local blob
  local extra
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    kind=""
    destination=""
    source=""
    blob=""
    extra=""
    read -r kind destination source blob extra <<< "$line"
    [[ -n "$kind" && -n "$destination" && -n "$source" && -n "$blob" ]] \
      || fail "test-sources.lock has an incomplete entry: $line"
    [[ -z "${extra:-}" ]] || fail "test-sources.lock contains extra fields: $destination"
    case "$kind" in
      suite)
        test_destinations+=("$destination")
        test_sources+=("$source")
        test_source_blobs+=("$blob")
        ;;
      support)
        support_destinations+=("$destination")
        support_sources+=("$source")
        support_source_blobs+=("$blob")
        ;;
      *) fail "test-sources.lock has an invalid kind: $kind" ;;
    esac
  done < Maintenance/test-sources.lock
}

files=()
unchanged_files=()
transformed_files=()
rules=()
test_destinations=()
test_sources=()
test_source_blobs=()
support_destinations=()
support_sources=()
support_source_blobs=()
read_files_manifest
read_rules_manifest
read_test_sources_lock

[[ "${#files[@]}" -gt 0 ]] || fail "empty files manifest"
[[ "${#unchanged_files[@]}" -gt 0 ]] || fail "files manifest has no A-owned files"
[[ "${#transformed_files[@]}" -gt 0 ]] || fail "files manifest has no C-owned files"
[[ "${#rules[@]}" -eq 25 ]] || fail "rules manifest must contain exactly 25 rules"
[[ "${#test_destinations[@]}" -eq 96 ]] \
  || fail "test-sources.lock must contain exactly 96 test sources"
[[ "${#support_destinations[@]}" -eq 5 ]] \
  || fail "test-sources.lock must contain exactly 5 support sources"
[[ "${#test_destinations[@]}" -eq "${#test_sources[@]}" ]] \
  || fail "test-sources.lock test columns have different counts"
[[ "${#support_destinations[@]}" -eq "${#support_sources[@]}" ]] \
  || fail "test-sources.lock support columns have different counts"

duplicate_files="$(printf '%s\n' "${files[@]}" | sort | uniq -d)"
[[ -z "$duplicate_files" ]] || fail "files.txt contains duplicate paths: $duplicate_files"
for file in "${files[@]}"; do
  case "$file" in
    /*|*'*'*|*'?'*|*'['*|*']'*|*'..'*)
      fail "files.txt contains a non-literal path: $file"
      ;;
    .gitignore|LICENSE.txt|Sources/SwiftFormat/*) ;;
    *)
      fail "files.txt path is outside the import area: $file"
      ;;
  esac
done

validate_test_source_path() {
  local destination="$1"
  local source="$2"
  case "$destination" in
    /*|*'*'*|*'?'*|*'['*|*']'*|*'..'*|*'//'*)
      fail "test-sources.lock contains a non-literal destination: $destination"
      ;;
    Tests/SwiftFormatTests/API/*|Tests/SwiftFormatTests/Core/*|\
      Tests/SwiftFormatTests/PrettyPrint/*|Tests/SwiftFormatTests/Rules/*|\
      Tests/SwiftFormatTests/Support/*) ;;
    *) fail "test destination is outside Tests/SwiftFormatTests: $destination" ;;
  esac
  case "$source" in
    /*|*'*'*|*'?'*|*'['*|*']'*|*'..'*|*'//'*)
      fail "test-sources.lock contains a non-literal source: $source"
      ;;
    Tests/SwiftFormatTests/API/*|Tests/SwiftFormatTests/Core/*|\
      Tests/SwiftFormatTests/PrettyPrint/*|Tests/SwiftFormatTests/Rules/*|\
      Sources/_SwiftFormatTestSupport/*) ;;
    *) fail "test source is outside the reviewed upstream test areas: $source" ;;
  esac
}

duplicate_test_destinations="$(printf '%s\n' "${test_destinations[@]}" | sort | uniq -d)"
[[ -z "$duplicate_test_destinations" ]] \
  || fail "test-sources.lock contains duplicate test destinations: $duplicate_test_destinations"
duplicate_support_destinations="$(printf '%s\n' "${support_destinations[@]}" | sort | uniq -d)"
[[ -z "$duplicate_support_destinations" ]] \
  || fail "test-sources.lock contains duplicate support destinations: $duplicate_support_destinations"
duplicate_destinations="$(printf '%s\n' "${test_destinations[@]}" "${support_destinations[@]}" | sort | uniq -d)"
[[ -z "$duplicate_destinations" ]] \
  || fail "test-sources.lock contains duplicate destinations: $duplicate_destinations"
duplicate_sources="$(printf '%s\n' "${test_sources[@]}" "${support_sources[@]}" | sort | uniq -d)"
[[ -z "$duplicate_sources" ]] \
  || fail "test-sources.lock contains duplicate upstream sources: $duplicate_sources"

for ((index = 0; index < ${#test_destinations[@]}; index++)); do
  destination="${test_destinations[$index]}"
  source="${test_sources[$index]}"
  expected_blob="${test_source_blobs[$index]}"
  validate_test_source_path "$destination" "$source"
  [[ "$expected_blob" =~ ^[0-9a-f]{40}$ ]] \
    || fail "invalid test source blob SHA for $destination: $expected_blob"
  actual_blob="$(git rev-parse "$LOCK_FORMAT_SHA:$source" 2>/dev/null || true)"
  [[ "$actual_blob" == "$expected_blob" ]] \
    || fail "upstream test source changed, deleted, or renamed: $source (destination $destination)"
  [[ -f "$destination" ]] || fail "missing local test snapshot: $destination"
  rg -q '^@Suite$' "$destination" \
    || fail "local test snapshot is not a Swift Testing suite: $destination"

  actual_methods="$(sed -n 's/^  func \(test[A-Za-z0-9_]*\)(.*/\1/p' "$destination")"
  if [[ "$destination" == "Tests/SwiftFormatTests/API/ConfigurationTests.swift" ]]; then
    expected_methods="$(
      printf '%s\n' \
        testDefaultConfigurationIsSameAsEmptyDecode \
        testDecodingReflowMultilineStringLiteralsAsString \
        testDecodingReflowMultilineStringLiteralsAsObject \
        testConfigurationWithComments
    )"
  else
    expected_methods="$(
      git show "$LOCK_FORMAT_SHA:$source" \
        | sed -n 's/^  func \(test[A-Za-z0-9_]*\)(.*/\1/p'
    )"
  fi
  [[ "$actual_methods" == "$expected_methods" ]] \
    || fail "local test methods differ from the reviewed upstream subset: $destination"
done

for ((index = 0; index < ${#support_destinations[@]}; index++)); do
  destination="${support_destinations[$index]}"
  source="${support_sources[$index]}"
  expected_blob="${support_source_blobs[$index]}"
  validate_test_source_path "$destination" "$source"
  [[ "$expected_blob" =~ ^[0-9a-f]{40}$ ]] \
    || fail "invalid support source blob SHA for $destination: $expected_blob"
  actual_blob="$(git rev-parse "$LOCK_FORMAT_SHA:$source" 2>/dev/null || true)"
  [[ "$actual_blob" == "$expected_blob" ]] \
    || fail "upstream support source changed, deleted, or renamed: $source (destination $destination)"
  [[ -f "$destination" ]] || fail "missing local test support snapshot: $destination"
  ! rg -q '^@Suite$' "$destination" \
    || fail "test support unexpectedly declares a suite: $destination"
done

duplicate_rules="$(printf '%s\n' "${rules[@]}" | sort | uniq -d)"
[[ -z "$duplicate_rules" ]] || fail "rules.txt contains duplicate rules: $duplicate_rules"
for rule in "${rules[@]}"; do
  [[ "$rule" =~ ^[A-Z][A-Za-z0-9]*$ ]] || fail "invalid rule name: $rule"
done

rule_file() {
  case "$1" in
    NoEmptyLinesOpeningClosingBraces) printf '%s\n' "Sources/SwiftFormat/Rules/NoEmptyLineOpeningClosingBraces.swift" ;;
    *) printf 'Sources/SwiftFormat/Rules/%s.swift\n' "$1" ;;
  esac
}

rule_test_file() {
  case "$1" in
    NoEmptyLinesOpeningClosingBraces)
      printf '%s\n' "Tests/SwiftFormatTests/Rules/NoEmptyLinesOpeningClosingBracesTests.swift"
      ;;
    OmitExplicitReturns)
      printf '%s\n' "Tests/SwiftFormatTests/Rules/OmitReturnsTests.swift"
      ;;
    *)
      printf 'Tests/SwiftFormatTests/Rules/%sTests.swift\n' "$1"
      ;;
  esac
}

for file in "${files[@]}"; do
  git cat-file -e "$LOCK_FORMAT_SHA:$file" 2>/dev/null || fail "missing or renamed upstream file: $file"
done

tag_pipeline_rules="$(git show "$LOCK_FORMAT_SHA:Sources/SwiftFormat/Core/Pipelines+Generated.swift" \
  | sed -n 's/.*node = \([A-Za-z0-9]*\)(context: context).*/\1/p')"
manifest_pipeline_rules="$(printf '%s\n' "${rules[@]}")"
[[ "$tag_pipeline_rules" == "$manifest_pipeline_rules" ]] \
  || fail "rules.txt does not exactly match the ordered $LOCK_TAG formatter pipeline"

for rule in "${rules[@]}"; do
  source_file="$(rule_file "$rule")"
  git cat-file -e "$LOCK_FORMAT_SHA:$source_file" 2>/dev/null || fail "missing rule source: $source_file"
  git show "$LOCK_FORMAT_SHA:$source_file" | rg -q "class $rule: SyntaxFormatRule" \
    || fail "rule is not a SyntaxFormatRule in the pinned tag: $rule"

  test_file="$(rule_test_file "$rule")"
  printf '%s\n' "${test_destinations[@]}" | rg -Fqx "$test_file" \
    || fail "missing retained formatter rule test snapshot: $test_file"
done

archive_path="$(mktemp /tmp/swift-format-lite-upstream.XXXXXX)"
trap 'rm -f -- "$archive_path"' EXIT
git archive --format=tar --output="$archive_path" "$LOCK_FORMAT_SHA" "${files[@]}"

# The source tree is an import area. Recreate it from the archive so removed
# upstream files cannot survive a sync. Tests remain the manually reviewed
# Swift Testing snapshot in the working tree.
rm -rf -- Sources/SwiftFormat
mkdir -p Sources/SwiftFormat
tar -xf "$archive_path"
rm -f -- "$archive_path"
trap - EXIT

apply_context_overlay() {
  local file="Sources/SwiftFormat/Core/Context.swift"
  rg -q 'fileURL: URL' "$file" || fail "Context source shape changed: expected URL field"
  perl -0pi -e 's/import Foundation\n//; s/fileURL: URL/fileName: String/g; s/self\.fileURL = fileURL/self.fileName = fileName/g; s/fileURL\.relativePath/fileName/g; s/URL/diagnostic source name/g; s/file URL/source name/g' "$file"
  rg -q 'fileName: String' "$file" || fail "Context overlay did not apply"
  ! rg -q '\bURL\b|fileURL|FileManager' "$file" || fail "Context still contains URL/file I/O"
}

apply_parsing_overlay() {
  local file="Sources/SwiftFormat/Core/Parsing.swift"
  rg -q 'assumingFileURL url: URL\?' "$file" || fail "Parsing source shape changed: expected URL parameter"
  rg -q 'experimentalFeatures: Set<String>' "$file" \
    || fail "Parsing source shape changed: expected experimental features"
  perl -0pi -e '
    s/import Foundation\n//;
    s/\@_spi\(ExperimentalLanguageFeatures\) import SwiftParser/import SwiftParser/;
    s/assumingFileURL url: URL\?/fileName: String/g;
    s/assumingFileURL: url/fileName: fileName/g;
    s/url\?\.path \?\? "<unknown>"/fileName/g;
    s/assumingFileURL/fileName/g;
    s/URL/source name/g;
    s/  - url:/  - fileName:/g;
    s/\/\/\/   - fileName: A file source name denoting the filename\/path that should be assumed for this syntax tree,\n\/\/\/     which is associated with any diagnostics emitted during formatting\. If this is nil, a\n\/\/\/     dummy value will be used\./\/\/\/   - fileName: The diagnostic source name associated with parser findings./;
    s/\/\/\/   - experimentalFeatures:[^\n]*\n\/\/\/[^\n]*\n\/\/\/[^\n]*\n\/\/\/[^\n]*\n//;
    s/  experimentalFeatures: Set<String>,\n//;
    s/  var experimentalFeaturesSet: Parser\.ExperimentalFeatures = \[\]\n  for featureName in experimentalFeatures \{.*?\n  \}\n//s;
    s/Parser\.parse\(source: sourceBytes, experimentalFeatures: experimentalFeaturesSet\)/Parser.parse(source: sourceBytes)/;
  ' "$file"
  rg -q 'fileName: String' "$file" || fail "Parsing overlay did not apply"
  ! rg -q '\bURL\b|FileManager|contentsOf|ExperimentalFeatures|experimentalFeatures|unrecognizedExperimentalFeature' "$file" \
    || fail "Parsing still contains excluded APIs"
}

apply_pretty_print_overlay() {
  local file="Sources/SwiftFormat/PrettyPrint/PrettyPrint.swift"
  rg -q 'context\.fileURL\.relativePath' "$file" \
    || fail "PrettyPrint source shape changed: expected URL finding location"
  perl -0pi -e 's/context\.fileURL\.relativePath/context.fileName/g' "$file"
  perl -0pi -e '
    s/\n  \/\/\/ If true, the token stream is printed to the console for debugging purposes\.\n  private var printTokenStream: Bool\n//;
    s/  \/\/\/   - printTokenStream: Indicates whether debug information about the token stream should be\n  \/\/\/     printed to standard output\.\n//;
    s/public init\(context: Context, source: String, node: Syntax, printTokenStream: Bool, whitespaceOnly: Bool\)/public init(context: Context, source: String, node: Syntax, whitespaceOnly: Bool)/;
    s/\n    self\.printTokenStream = printTokenStream//;
    s/\n    if self\.printTokenStream \{\n      printDebugToken\(token: token, length: length, idx: idx\)\n    \}//;
    s/\n          print\("Bad index 1"\)//;
    s/\n            print\("Bad index 2"\)//;
    s/\n  \/\/\/ Used to track the indentation level for the debug token stream output\..*?\n  \/\/\/ Emits a finding/\n  \/\/\/ Emits a finding/s;
  ' "$file"
  rg -q 'context\.fileName' "$file" || fail "PrettyPrint overlay did not apply"
  ! rg -q '\bURL\b|fileURL|FileManager|contentsOf' "$file" \
    || fail "PrettyPrint still contains URL/file I/O"
  ! rg -q 'printTokenStream|printDebugToken|^[[:space:]]*print\(' "$file" \
    || fail "PrettyPrint still contains console output"
}

apply_configuration_overlay() {
  local file="Sources/SwiftFormat/API/Configuration.swift"
  rg -q 'public init\(contentsOf url: URL\)' "$file" || fail "Configuration source shape changed: expected file initializer"
  rg -q 'url\(forConfigurationFileApplyingTo url: URL\)' "$file" || fail "Configuration source shape changed: expected config search"
  perl -0pi -e 's/  \/\/\/ Creates a new `Configuration` by loading it from a configuration file\.\n  public init\(contentsOf url: URL\) throws \{\n    let data = try Data\(contentsOf: url\)\n    try self\.init\(data: data\)\n  \}\n\n//s; s/  \/\/\/ Returns the URL of the configuration file that applies to the given file or directory\.\n  public static func url\(forConfigurationFileApplyingTo url: URL\) -> URL\? \{.*?\n  \}\n//s' "$file"
  ! rg -q 'contentsOf|FileManager|\bURL\b|url\(forConfiguration' "$file" || fail "Configuration still contains file I/O"
}

apply_error_overlay() {
  local file="Sources/SwiftFormat/API/SwiftFormatError.swift"
  rg -q 'case fileNotReadable' "$file" || fail "SwiftFormatError source shape changed: expected file error"
  rg -q 'case isDirectory' "$file" || fail "SwiftFormatError source shape changed: expected directory error"
  rg -q 'case unrecognizedExperimentalFeature' "$file" \
    || fail "SwiftFormatError source shape changed: expected experimental feature error"
  rg -q 'case configurationDumpFailed' "$file" \
    || fail "SwiftFormatError source shape changed: expected configuration dump error"
  perl -0pi -e '
    s/import SwiftSyntax\n//;
    s/Errors that can be thrown by the `SwiftFormatter` and `SwiftLinter` APIs\./Errors that can be thrown by the `SwiftFormatter` API./;
    s/\n  \/\/\/ The requested file was not readable or it did not exist\.\n  case fileNotReadable\n\n  \/\/\/ The requested file was a directory\.\n  case isDirectory\n//;
    s/\n  \/\/\/ The requested experimental feature name was not recognized by the parser\.\n  case unrecognizedExperimentalFeature\(String\)\n//;
    s/\n  \/\/\/ An error happened while dumping the tool'\''s configuration\.\n  case configurationDumpFailed\(String\)\n//;
    s/\n    case \.fileNotReadable:\n      return "file is not readable or does not exist"\n    case \.isDirectory:\n      return "requested path is a directory, not a file"//;
    s/\n    case \.unrecognizedExperimentalFeature\(let name\):\n      return "experimental feature '\''\\\(name\)'\'' was not recognized by the Swift parser"//;
    s/\n    case \.configurationDumpFailed\(let message\):\n      return "dumping configuration failed: \\\(message\)"//;
  ' "$file"
  ! rg -q 'fileNotReadable|isDirectory|unrecognizedExperimentalFeature|configurationDumpFailed|SwiftLinter|FileManager|contentsOf|\bURL\b|SwiftSyntax' "$file" \
    || fail "SwiftFormatError still contains excluded APIs"
}

apply_context_overlay
apply_parsing_overlay
apply_pretty_print_overlay
apply_configuration_overlay
apply_error_overlay

generate_pipeline() {
  local file="Sources/SwiftFormat/Core/Pipelines+Generated.swift"
  {
    printf '%s\n' '// Generated by Maintenance/sync-upstream. Do not edit.'
    printf '%s\n' 'import SwiftSyntax'
    printf '%s\n' 'extension FormatPipeline {'
    printf '%s\n' '  func rewrite(_ node: Syntax) -> Syntax {'
    printf '%s\n' '    var node = node'
    for rule in "${rules[@]}"; do
      printf '    node = %s(context: context).rewrite(node)\n' "$rule"
    done
    printf '%s\n' '    return node' '  }' '}'
  } > "$file"
}

generate_registry() {
  local file="Sources/SwiftFormat/Core/RuleRegistry+Generated.swift"
  local upstream_registry
  upstream_registry="$(git show "$LOCK_FORMAT_SHA:Sources/SwiftFormat/Core/RuleRegistry+Generated.swift")"
  {
    printf '%s\n' '// Generated by Maintenance/sync-upstream. Do not edit.'
    printf '%s\n' '@_spi(Internal) public enum RuleRegistry {' '  public static let rules: [String: Bool] = ['
    for rule in "${rules[@]}"; do
      enabled="$(sed -n "s/^[[:space:]]*\"$rule\": \\([^,]*\\),$/\\1/p" <<< "$upstream_registry")"
      [[ "$enabled" == "true" || "$enabled" == "false" ]] \
        || fail "cannot determine upstream default enablement for $rule"
      printf '    "%s": %s,\n' "$rule" "$enabled"
    done
    printf '%s\n' '  ]' '}'
  } > "$file"
}

generate_name_cache() {
  local file="Sources/SwiftFormat/Core/RuleNameCache+Generated.swift"
  {
    printf '%s\n' '// Generated by Maintenance/sync-upstream. Do not edit.'
    printf '%s\n' '@_spi(Testing) public let ruleNameCache: [ObjectIdentifier: String] = ['
    for rule in "${rules[@]}"; do
      printf '  ObjectIdentifier(%s.self): "%s",\n' "$rule" "$rule"
    done
    printf '%s\n' ']'
  } > "$file"
}

generate_pipeline
generate_registry
generate_name_cache

cp Maintenance/overlays/SwiftFormatter.swift Sources/SwiftFormat/API/SwiftFormatter.swift

for file in "${unchanged_files[@]}"; do
  actual_hash="$(git hash-object "$file")"
  upstream_hash="$(git rev-parse "$LOCK_FORMAT_SHA:$file")"
  [[ "$actual_hash" == "$upstream_hash" ]] \
    || fail "A-owned file differs from pinned upstream: $file"
done

for generated in Sources/SwiftFormat/Core/Pipelines+Generated.swift \
  Sources/SwiftFormat/Core/RuleRegistry+Generated.swift \
  Sources/SwiftFormat/Core/RuleNameCache+Generated.swift; do
  for rule in "${rules[@]}"; do
    rg -q "\b${rule}\b" "$generated" || fail "generated file does not reference $rule: $generated"
  done
done

for rule in "${rules[@]}"; do
  file="$(rule_file "$rule")"
  [[ -f "$file" ]] || fail "expected formatter rule source is absent: $file"
  ! rg -q 'SyntaxLintRule' "$file" || fail "lint rule was imported: $file"
done

io_hits="$(rg -n \
  -e 'format\(contentsOf:' \
  -e 'Configuration\(contentsOf:' \
  -e 'String\(contentsOf:' \
  -e 'Data\(contentsOf:' \
  -e '\bFileManager\b' \
  -e '\bFileHandle\b' \
  -e '\bURL\b' \
  -e 'assumingFileURL' \
  -e 'url\(forConfigurationFileApplyingTo' \
  Sources/SwiftFormat || true)"
[[ -z "$io_hits" ]] || fail "library Sources contain file I/O symbols:\n$io_hits"

expected_test_files="$(printf '%s\n' "${test_destinations[@]}" "${support_destinations[@]}" | sort)"
actual_test_files="$(find Tests/SwiftFormatTests -type f -print | sort)"
[[ "$actual_test_files" == "$expected_test_files" ]] \
  || fail "local test tree differs from test-sources.lock"

suite_count="$(rg -l '^@Suite$' Tests/SwiftFormatTests | wc -l | tr -d ' ')"
test_count="$(rg -n '^  @Test$' Tests/SwiftFormatTests | wc -l | tr -d ' ')"
[[ "$suite_count" -eq 96 ]] || fail "expected 96 Swift Testing suites, found $suite_count"
[[ "$test_count" -eq 759 ]] || fail "expected 759 tests, found $test_count"

for expectation in \
  "API:1:4" \
  "Core:2:24" \
  "PrettyPrint:68:559" \
  "Rules:25:172"; do
  category="${expectation%%:*}"
  counts="${expectation#*:}"
  expected_suites="${counts%%:*}"
  expected_tests="${counts#*:}"
  actual_suites="$(rg -l '^@Suite$' "Tests/SwiftFormatTests/$category" | wc -l | tr -d ' ')"
  actual_tests="$(rg -n '^  @Test$' "Tests/SwiftFormatTests/$category" | wc -l | tr -d ' ')"
  [[ "$actual_suites" -eq "$expected_suites" ]] \
    || fail "$category suite count changed: expected $expected_suites, found $actual_suites"
  [[ "$actual_tests" -eq "$expected_tests" ]] \
    || fail "$category test count changed: expected $expected_tests, found $actual_tests"
done

legacy_test_hits="$(rg -n \
  -e '^import XCTest$' \
  -e ': XCTestCase' \
  -e 'import _SwiftFormatTestSupport' \
  Tests/SwiftFormatTests || true)"
[[ -z "$legacy_test_hits" ]] || fail "local tests still depend on XCTest support:\n$legacy_test_hits"

excluded_test_hits="$(rg -n \
  -e '^import Markdown$' \
  -e '\bSyntaxLintRule\b' \
  -e '\bSwiftLinter\b' \
  -e '\bLintPipeline\b' \
  -e '\bWhitespaceLinter\b' \
  -e '\bWhitespaceTestCase\b' \
  -e '\bSwiftFormatWasm\b' \
  Tests/SwiftFormatTests || true)"
[[ -z "$excluded_test_hits" ]] \
  || fail "local tests contain excluded lint, Markdown, whitespace, or WASM support:\n$excluded_test_hits"

test_io_hits="$(rg -n \
  -e 'Data\(contentsOf:' \
  -e 'String\(contentsOf:' \
  -e 'URL\(fileURLWithPath:' \
  -e '\bFileManager\b' \
  -e '\bFileHandle\b' \
  -e 'url\(forConfigurationFileApplyingTo' \
  Tests/SwiftFormatTests || true)"
[[ -z "$test_io_hits" ]] || fail "local tests contain file I/O:\n$test_io_hits"

for destination in "${test_destinations[@]}"; do
  case "$destination" in
    *Whitespace*|*Lint*|*Wasm*|*WASM*)
      fail "excluded test category is locked: $destination"
      ;;
  esac
done

printf 'sync-upstream: restored %d source files, audited %d tests in %d suites, and generated %d formatter rules from %s\n' \
  "${#files[@]}" "$test_count" "$suite_count" "${#rules[@]}" "$LOCK_FORMAT_SHA"
